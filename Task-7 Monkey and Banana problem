class MonkeyBanana:
    def __init__(self):
        self.monkey_position = "Window"
        self.box_position = "Window"
        self.monkey_on_box = False
        self.has_banana = False

    def solve(self):
        print("Monkey moves to box")
        self.monkey_position = "Box"

        print("Monkey pushes box to center")
        self.box_position = "Center"
        self.monkey_position = "Center"

        print("Monkey climbs box")
        self.monkey_on_box = True

        print("Monkey touches bananas!")
        self.has_banana = True

        if self.has_banana:
            print("Goal Reached")


# Create object
monkey = MonkeyBanana()

# Solve the problem
monkey.solve()
