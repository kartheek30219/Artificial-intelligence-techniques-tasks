      "cell_type": "code",
      "source": [
        "\n",
        "\n",
        "heights = [1, 3, 5, 7, 6, 8, 9, 7, 5, 10]\n",
        "current = 0\n",
        "\n",
        "print(\"Starting position:\", current)\n",
        "print(\"Starting height:\", heights[current])\n",
        "\n",
        "while True:\n",
        "\n",
        "    left = current - 1\n",
        "    right = current + 1\n",
        "\n",
        "    best = current\n",
        "    if left >= 0 and heights[left] > heights[best]:\n",
        "        best = left\n",
        "\n",
        "\n",
        "    if right < len(heights) and heights[right] > heights[best]:\n",
        "        best = right\n",
        "\n",
        "    if best == current:\n",
        "        print(\"\\nNo better neighbor found!\")\n",
        "        print(\"Hill climbing stopped.\")\n",
        "        break\n",
        "\n",
        "    current = best\n",
        "\n",
        "    print(\"Moved to position:\", current,\n",
        "          \"Height:\", heights[current])\n",
        "\n",
        "print(\"\\nFinal position:\", current)\n",
        "print(\"Final height:\", heights[current])"
