      "source": [
        "# DFS for A–B–C tree\n",
        "tree = {\n",
        "    'A': ['B', 'C'],\n",
        "    'B': [],\n",
        "    'C': []\n",
        "}\n",
        "\n",
        "def dfs(tree, start, visited=None):\n",
        "    if visited is None:\n",
        "        visited = set()\n",
        "    visited.add(start)\n",
        "    print(start, end=\" \")\n",
        "\n",
        "    for child in tree[start]:\n",
        "        if child not in visited:\n",
        "            dfs(tree, child, visited)\n",
        "\n",
        "print(\"DFS Traversal:\")\n",
        "dfs(tree, 'A')\n"
      ],
